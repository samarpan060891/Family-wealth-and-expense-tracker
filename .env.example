# Postgres connection string for production/deployment.
# Leave unset (or "pglite") to use a local embedded Postgres for development —
# no separate database server required.
DATABASE_URL=postgres://user:password@host:5432/familywealth

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# Optional: enables auto-reading uploaded bills/statements/policies to pre-fill add forms.
# Without it, uploads still attach normally — they just aren't auto-scanned.
# Get a key from https://console.anthropic.com (API billing is separate from a
# claude.ai Pro/Team subscription — it's metered pay-per-use, but reading a bill
# with the default Haiku model costs a fraction of a cent).
ANTHROPIC_API_KEY=
# Optional: model used for document extraction. Defaults to claude-haiku-4-5
# (cheapest). Set claude-opus-4-8 for higher accuracy on complex documents.
# EXTRACTION_MODEL=claude-opus-4-8
